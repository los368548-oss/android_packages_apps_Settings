<resources>

    <!-- HavocOOS Enhanced Glassmorphic Card Styles -->
    
    <!-- Base Glassmorphic Card Style -->
    <style name="HavocOOSCardStyle" parent="Widget.MaterialComponents.CardView">
        <!-- Transparent background for glass effect -->
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <!-- Rounded corners matching glassmorphic design -->
        <item name="cardCornerRadius">@dimen/havoc_card_corner_radius</item>
        <!-- Subtle elevation for depth -->
        <item name="cardElevation">@dimen/havoc_elevation_low</item>
        <!-- Prevent card from clipping ripple -->
        <item name="cardPreventCornerOverlap">false</item>
        <!-- Use compat padding for consistent appearance -->
        <item name="cardUseCompatPadding">true</item>
        <!-- Content padding -->
        <item name="contentPadding">@dimen/havoc_padding_normal</item>
        <!-- Ripple color -->
        <item name="rippleColor">@color/glassmorphic_ripple_light</item>
    </style>
    
    <!-- Premium Glassmorphic Card Style with Shimmer -->
    <style name="HavocOOSCardStyle.Premium" parent="HavocOOSCardStyle">
        <item name="cardElevation">@dimen/havoc_elevation_medium</item>
        <item name="rippleColor">@color/glassmorphic_ripple_medium</item>
    </style>
    
    <!-- Compact Glassmorphic Card Style -->
    <style name="HavocOOSCardStyle.Compact" parent="HavocOOSCardStyle">
        <item name="contentPadding">@dimen/havoc_padding_compact</item>
        <item name="cardCornerRadius">@dimen/havoc_corner_radius</item>
    </style>
    
    <!-- Glassmorphic Preference Container Style -->
    <style name="HavocOOSPreferenceContainer">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
        <item name="android:paddingStart">@dimen/havoc_padding_normal</item>
        <item name="android:paddingEnd">@dimen/havoc_padding_normal</item>
        <item name="android:paddingTop">@dimen/havoc_padding_compact</item>
        <item name="android:paddingBottom">@dimen/havoc_padding_compact</item>
    </style>
    
    <!-- Glassmorphic Icon Container Style -->
    <style name="HavocOOSIconContainer">
        <item name="android:minWidth">@dimen/havoc_icon_container_min_width</item>
        <item name="android:minHeight">@dimen/havoc_icon_container_min_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/havoc_padding_normal</item>
    </style>
    
    <!-- Glassmorphic Title Text Style -->
    <style name="HavocOOSTitleText" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/settingslib_text_color_primary</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <!-- Glassmorphic Summary Text Style -->
    <style name="HavocOOSSummaryText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/settingslib_text_color_secondary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
