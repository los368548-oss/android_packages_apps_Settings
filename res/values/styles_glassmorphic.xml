<resources>

    <!-- Glassmorphic Card Style -->
    <style name="GlassmorphicCard">
        <item name="android:background">@drawable/device_info_card_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
    </style>

    <!-- Glassmorphic Banner Style -->
    <style name="GlassmorphicBanner">
        <item name="android:background">@drawable/havoc_banner_background</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
    </style>

    <!-- Device Info Title Style -->
    <style name="DeviceInfoTitle" parent="TextAppearance.SettingsLib.BodyLarge">
        <item name="android:textColor">@color/device_info_title</item>
        <item name="android:textStyle">medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Device Info Summary Style -->
    <style name="DeviceInfoSummary" parent="TextAppearance.SettingsLib.BodyMedium">
        <item name="android:textColor">@color/device_info_summary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Havoc Banner Title Style -->
    <style name="HavocBannerTitle" parent="TextAppearance.SettingsLib.HeadlineMedium">
        <item name="android:textColor">@color/havoc_banner_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Havoc Banner Version Style -->
    <style name="HavocBannerVersion" parent="TextAppearance.SettingsLib.BodyMedium">
        <item name="android:textColor">@color/havoc_banner_subtitle</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Havoc Banner Status Style -->
    <style name="HavocBannerStatus" parent="TextAppearance.SettingsLib.LabelSmall">
        <item name="android:textColor">@color/havoc_banner_accent</item>
    </style>

    <!-- Progress Label Style -->
    <style name="ProgressLabel" parent="TextAppearance.SettingsLib.LabelSmall">
        <item name="android:textColor">@color/device_info_summary</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>
