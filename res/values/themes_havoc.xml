<resources xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:androidprv="http://schemas.android.com/apk/prv/res/android">

    <!-- HavocOOS Glassmorphic Material 3 Expressive Theme -->
    <style name="Theme.Settings.HavocOOS" parent="Theme.Settings.Expressive">
        <!-- Glassmorphic backgrounds -->
        <item name="preferenceBackgroundColor">@drawable/glassmorphic_bg</item>
        
        <!-- Reduced tile height for compact layout -->
        <item name="android:listPreferredItemHeight">60dp</item>
        
        <!-- Enhanced rounded corners -->
        <item name="android:dialogCornerRadius">28dp</item>
        
        <!-- Transparent backgrounds for glass effect -->
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <style name="Theme.SubSettings.HavocOOS" parent="Theme.SubSettings.Expressive">
        <!-- Glassmorphic backgrounds -->
        <item name="preferenceBackgroundColor">@drawable/glassmorphic_bg</item>
        
        <!-- Reduced tile height -->
        <item name="android:listPreferredItemHeight">60dp</item>
    </style>

    <style name="Theme.Settings.Home.HavocOOS" parent="Theme.Settings.Home.Expressive">
        <!-- Glassmorphic backgrounds -->
        <item name="preferenceBackgroundColor">@drawable/glassmorphic_bg</item>
        
        <!-- Reduced tile height -->
        <item name="android:listPreferredItemHeight">60dp</item>
    </style>

    <!-- Glassmorphic Preference Styles -->
    <style name="HavocOOS.Preference" parent="@style/Preference.Material">
        <item name="android:background">@drawable/glassmorphic_bg</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="HavocOOS.Preference.Card" parent="@style/HavocOOS.Preference">
        <item name="android:background">@drawable/glassmorphic_bg</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- Glassmorphic Homepage Preference -->
    <style name="HavocOOS.HomepagePreference" parent="@style/Preference.Material">
        <item name="android:background">@drawable/glassmorphic_bg</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <!-- Glassmorphic Category Style -->
    <style name="HavocOOS.PreferenceCategory" parent="@style/Preference.Category.Material">
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <!-- HavocOOS Glassmorphic Card Style -->
    <style name="HavocOOSCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">28dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#30FFFFFF</item>
        <item name="rippleColor">#20FFFFFF</item>
    </style>

    <!-- Glassmorphic Dialog Style -->
    <style name="HavocOOS.Dialog" parent="@style/Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@drawable/glassmorphic_bg</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Glassmorphic Alert Dialog Style -->
    <style name="HavocOOS.AlertDialog" parent="@style/Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/glassmorphic_bg</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

</resources>
