<!-- This file only contains custom attribute and style definition for preferences -->
<!-- Things unrelated to preference framework UI customization should go to other styles files -->
<resources>

    <style name="SettingsPreferenceTheme.Expressive" parent="@style/PreferenceTheme.SettingsLib.Expressive">
        <item name="cardPreferenceStyle">@style/CardPreference.Expressive</item>
        <item name="slicePreferenceStyle">@style/SlicePreference.Expressive</item>
        <item name="seekBarPreferenceStyle">@style/SettingsSeekBarPreference.Expressive</item>
        <item name="twoStateButtonPreferenceStyle">@style/TwoStateButtonPreference</item>
        <item name="preferenceFragmentCompatStyle">@style/SettingsPreferenceFragmentStyle</item>
        <!-- HavocOOS: Enhanced Glassmorphic preference styles for Expressive -->
        <item name="preferenceStyle">@style/HavocOOS.Preference.Expressive</item>
        <item name="preferenceCategoryStyle">@style/HavocOOS.PreferenceCategory.Expressive</item>
        <item name="switchPreferenceStyle">@style/HavocOOS.SwitchPreference.Expressive</item>
        <item name="checkBoxPreferenceStyle">@style/HavocOOS.CheckBoxPreference.Expressive</item>
        <item name="editTextPreferenceStyle">@style/HavocOOS.EditTextPreference.Expressive</item>
        <item name="dialogPreferenceStyle">@style/HavocOOS.DialogPreference.Expressive</item>
        <item name="dropdownPreferenceStyle">@style/HavocOOS.DropdownPreference.Expressive</item>
    </style>

    <style name="CardPreference.Expressive" parent="@style/Preference.Material">
        <item name="android:layout">@layout/card_preference_layout</item>
        <item name="android:background">@drawable/glassmorphic_selector</item>
    </style>

    <style name="SlicePreference.Expressive" parent="@style/Preference.Material">
        <item name="android:layout">@layout/slice_preference_layout</item>
        <item name="android:background">@drawable/glassmorphic_selector</item>
    </style>

    <style name="SettingsSeekBarPreference.Expressive" parent="@style/Preference.Material">
        <item name="android:layout">@layout/preference_widget_seekbar_settings</item>
        <item name="iconSpaceReserved">@bool/settingslib_config_icon_space_reserved</item>
        <item name="android:background">@drawable/glassmorphic_selector</item>
    </style>

    <style name="SyncSwitchPreference.Expressive" parent="@style/SettingsLibPreference.SwitchPreferenceCompat.Expressive">
        <item name="android:widgetLayout">@layout/preference_widget_sync_toggle_expreesive</item>
    </style>

    <!-- HavocOOS Enhanced Glassmorphic Expressive Preference Styles -->
    <style name="HavocOOS.Preference.Expressive" parent="@style/Preference.Material">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HavocOOS.PreferenceCategory.Expressive" parent="@style/Preference.Material.PreferenceCategory">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="allowDividerAbove">false</item>
    </style>

    <style name="HavocOOS.SwitchPreference.Expressive" parent="@style/Preference.SwitchPreference.Material">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HavocOOS.CheckBoxPreference.Expressive" parent="@style/Preference.CheckBoxPreference.Material">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HavocOOS.EditTextPreference.Expressive" parent="@style/Preference.DialogPreference.EditTextPreference.Material">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HavocOOS.DialogPreference.Expressive" parent="@style/Preference.DialogPreference.Material">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="HavocOOS.DropdownPreference.Expressive" parent="@style/Preference.DropDown.Material">
        <item name="android:background">@drawable/glassmorphic_selector</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- Premium Highlighted Preference Style (for special items) -->
    <style name="HavocOOS.Preference.Highlighted" parent="@style/Preference.Material">
        <item name="android:background">@drawable/glassmorphic_shimmer</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <!-- Accent Tinted Preference Style -->
    <style name="HavocOOS.Preference.Accent" parent="@style/Preference.Material">
        <item name="android:background">@drawable/glassmorphic_accent</item>
        <item name="android:layout_marginStart">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/havoc_preference_margin_horizontal</item>
        <item name="android:layout_marginTop">@dimen/havoc_preference_margin_vertical</item>
        <item name="android:layout_marginBottom">@dimen/havoc_preference_margin_vertical</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

</resources>
