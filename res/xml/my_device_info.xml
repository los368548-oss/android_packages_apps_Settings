<!-- 
  About Phone Layout - Reorganized with Combined Tiles
  Categories: Banner → Device Overview → Hardware → Software → Network → Quick Links
-->

<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="my_device_info_pref_screen"
    android:title="@string/about_settings">

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HAVOCOOS BANNER - Hero Section -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    
    <!-- HavocOOS Banner - Clickable to go to Updater -->
    <com.android.settingslib.widget.LayoutPreference
        android:key="havoc_banner"
        android:layout="@layout/havoc_banner_preference"
        android:selectable="true"
        android:order="0"
        settings:controller="com.android.settings.deviceinfo.aboutphone.HavocBannerPreferenceController"/>

    <com.android.settingslib.widget.LayoutPreference
        android:key="my_device_info_header"
        android:layout="@layout/settings_entity_header"
        android:selectable="false"
        settings:isPreferenceVisible="false"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- DEVICE OVERVIEW - Device Name + Storage -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:key="device_overview_category"
        android:selectable="false"
        android:title="@string/device_info_overview_category_title"
        android:order="1">

        <!-- Combined Device Name + Storage Tile -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="device_overview_tile"
            android:layout="@layout/device_name_storage_tile"
            android:selectable="false"
            android:order="1"
            settings:controller="com.android.settings.deviceinfo.aboutphone.DeviceOverviewPreferenceController"/>

    </PreferenceCategory>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- HARDWARE INFO - Combined Grid Tiles -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:key="hardware_info_category"
        android:selectable="false"
        android:title="@string/device_info_hardware_category_title"
        android:order="2">

        <!-- Hardware Grid Tile 1: Processor + RAM -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="hardware_tile_processor_ram"
            android:layout="@layout/hardware_grid_tile"
            android:selectable="false"
            android:order="1"
            settings:controller="com.android.settings.deviceinfo.aboutphone.ProcessorRamPreferenceController"/>

        <!-- Hardware Grid Tile 2: Battery + Display -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="hardware_tile_battery_display"
            android:layout="@layout/hardware_grid_tile"
            android:selectable="false"
            android:order="2"
            settings:controller="com.android.settings.deviceinfo.aboutphone.BatteryDisplayPreferenceController"/>

        <!-- Hardware Grid Tile 3: Camera + GPU -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="hardware_tile_camera_gpu"
            android:layout="@layout/hardware_grid_tile"
            android:selectable="false"
            android:order="3"
            settings:controller="com.android.settings.deviceinfo.aboutphone.CameraGpuPreferenceController"/>

    </PreferenceCategory>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- SOFTWARE INFO - Combined Grid Tiles -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:key="software_info_category"
        android:selectable="false"
        android:title="@string/my_device_info_basic_info_category_title"
        android:order="3">

        <!-- Android Version - Full Width Card -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="android_version"
            android:layout="@layout/device_info_card_preference"
            android:selectable="true"
            android:order="1"
            settings:controller="com.android.settings.deviceinfo.firmwareversion.FirmwareVersionPreferenceController"/>

        <!-- Software Grid Tile 1: SIM Status + Phone Number -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="software_tile_sim_phone"
            android:layout="@layout/software_grid_tile"
            android:selectable="true"
            android:order="2"
            settings:controller="com.android.settings.deviceinfo.aboutphone.SimPhonePreferenceController"/>

        <!-- Software Grid Tile 2: Model + IMEI -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="software_tile_model_imei"
            android:layout="@layout/software_grid_tile"
            android:selectable="true"
            android:order="3"
            settings:controller="com.android.settings.deviceinfo.aboutphone.ModelImeiPreferenceController"/>

        <!-- EID (for eSIM devices) -->
        <com.android.settings.deviceinfo.simstatus.SimEidInfoPreference
            android:key="eid_info"
            android:order="4"
            android:title="@string/status_eid"
            android:positiveButtonText="@string/dlg_ok"
            android:dialogLayout="@layout/dialog_eid_status"
            settings:isPreferenceVisible="@bool/config_show_sim_info"
            settings:enableCopying="true"
            settings:controller="com.android.settings.deviceinfo.simstatus.SimEidPreferenceController"/>

    </PreferenceCategory>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- NETWORK & IDENTIFIERS - Combined Grid Tiles -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:key="network_identifiers_category"
        android:selectable="false"
        android:title="@string/my_device_info_device_identifiers_category_title"
        android:order="4">

        <!-- Network Grid Tile 1: Wi-Fi MAC + Bluetooth MAC -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="network_tile_wifi_bt"
            android:layout="@layout/network_grid_tile"
            android:selectable="false"
            android:order="1"
            settings:controller="com.android.settings.deviceinfo.aboutphone.WifiBtMacPreferenceController"/>

        <!-- Network Grid Tile 2: Uptime + Build Number -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="network_tile_uptime_build"
            android:layout="@layout/network_grid_tile"
            android:selectable="true"
            android:order="2"
            settings:controller="com.android.settings.deviceinfo.aboutphone.UptimeBuildPreferenceController"/>

        <!-- IP Address -->
        <Preference
            android:key="wifi_ip_address"
            android:order="3"
            android:title="@string/wifi_ip_address"
            android:summary="@string/summary_placeholder"
            android:selectable="false"
            settings:enableCopying="true"/>

    </PreferenceCategory>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- QUICK LINKS - Compact Footer -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <PreferenceCategory
        android:key="quick_links_category"
        android:selectable="false"
        android:title="@string/my_device_info_legal_category_title"
        android:order="5">

        <!-- Quick Links Tile -->
        <com.android.settingslib.widget.LayoutPreference
            android:key="quick_links_tile"
            android:layout="@layout/quick_links_tile"
            android:selectable="false"
            android:order="1"
            settings:controller="com.android.settings.deviceinfo.aboutphone.QuickLinksPreferenceController"/>

    </PreferenceCategory>

</PreferenceScreen>
