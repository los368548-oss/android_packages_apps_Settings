<!-- Glassmorphic Storage Accent - Dark Mode - Orange Theme -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glassmorphic_ripple_dark">
    
    <!-- Mask for ripple bounds -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <item>
        <layer-list>
            
            <!-- Layer 1: Deep shadow with purple tint -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/glassmorphic_gradient_dark_start"
                        android:centerColor="@color/glassmorphic_gradient_dark_center"
                        android:endColor="@color/glassmorphic_gradient_dark_end"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 2: Primary glass surface with purple tint -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glassmorphic_surface_dark"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 3: Diagonal light reflection -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="145"
                        android:startColor="#00FFFFFF"
                        android:centerColor="@color/glassmorphic_highlight_dark_shimmer"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 4: Top highlight for glass reflection -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="@color/glassmorphic_highlight_dark_top"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 5: Orange accent glow from bottom -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/category_accent_storage_surface"
                        android:centerColor="#08FFA726"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 6: Primary border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke
                        android:width="1dp"
                        android:color="@color/glassmorphic_border_dark_primary"/>
                </shape>
            </item>
            
            <!-- Layer 7: Orange accent border glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="@color/category_accent_storage"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
</ripple>