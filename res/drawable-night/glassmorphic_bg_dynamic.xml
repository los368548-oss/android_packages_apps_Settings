<!-- 
  Material You Dynamic Glassmorphic Background v4.0 - Dark Mode
  
  This is the dark mode entry point for dynamic glassmorphic backgrounds.
  The colors automatically adapt to the user's wallpaper through Material You (Monet).
  
  Dark mode features enhanced contrast and more prominent accent glows.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Uses the dynamic selector which adapts to wallpaper colors -->
    <item android:drawable="@drawable/glassmorphic_selector_dynamic"/>
</selector>