<!-- Subpage Preference Layout - Premium Glassmorphic Design v2.0 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp">

        <!-- Glassmorphic background - Dynamic Material You colors -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/glassmorphic_selector_dynamic"/>

        <!-- Top highlight reflection -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_gravity="top"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="#70FFFFFF"
            android:alpha="0.8"/>

        <!-- Content Container - Horizontal LinearLayout to support weights -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Icon Container with accent glow -->
            <FrameLayout
                android:id="@+id/icon_frame"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="14dp">

                <!-- Icon background glow -->
                <View
                    android:id="@+id/icon_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/device_info_icon_bg"
                    android:alpha="0.35"/>

                <!-- Icon -->
                <androidx.preference.internal.PreferenceImageView
                    android:id="@android:id/icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:scaleType="centerInside"/>

            </FrameLayout>

            <!-- Text Content - Now properly supports layout_weight -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Title -->
                <TextView
                    android:id="@android:id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
                    android:textColor="@color/device_info_title"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.01"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <!-- Summary -->
                <TextView
                    android:id="@android:id/summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                    android:textColor="@color/device_info_summary"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Widget frame (for switches, etc.) -->
            <LinearLayout
                android:id="@android:id/widget_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:gravity="center"
                android:orientation="horizontal"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>