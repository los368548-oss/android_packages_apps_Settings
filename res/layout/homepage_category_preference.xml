<!-- Homepage Category Preference with Visual Effects -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/category_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground">

        <!-- Animated gradient background -->
        <View
            android:id="@+id/animated_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/homepage_category_background"/>

        <!-- Shimmer overlay -->
        <View
            android:id="@+id/shimmer_layer"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/shimmer_gradient"
            android:visibility="visible"/>

        <!-- Category accent bar -->
        <View
            android:id="@+id/accent_bar"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/category_accent_bar"/>

        <!-- Content container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Icon Container with animated glow -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp">

                <!-- Icon background glow -->
                <View
                    android:id="@+id/icon_glow"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/device_info_icon_bg"/>

                <!-- Icon -->
                <ImageView
                    android:id="@+id/category_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings_wireless_filled"
                    android:contentDescription="@null"/>

            </FrameLayout>

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title -->
                <TextView
                    android:id="@+id/category_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium"
                    android:textColor="@color/havoc_banner_title"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"/>

                <!-- Summary -->
                <TextView
                    android:id="@+id/category_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                    android:textColor="@color/havoc_banner_subtitle"
                    android:maxLines="2"
                    android:ellipsize="end"/>

            </LinearLayout>

            <!-- Arrow indicator -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/havoc_banner_accent"
                android:alpha="0.6"
                android:contentDescription="@null"/>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>