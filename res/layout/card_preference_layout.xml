<!-- HavocOOS: Enhanced Glassmorphic card preference layout with ripple -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/havoc_preference_margin_vertical"
    android:layout_marginStart="@dimen/havoc_preference_margin_horizontal"
    android:layout_marginEnd="@dimen/havoc_preference_margin_horizontal"
    android:clickable="true"
    android:focusable="true"
    style="@style/HavocOOSCardStyle">

    <!-- Glassmorphic background layer -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/glassmorphic_selector"/>

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-8dp"
        layout="@layout/card_preference"/>
</com.google.android.material.card.MaterialCardView>
