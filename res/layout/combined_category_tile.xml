<!-- Combined Category Tile - 3 Items in One Tile -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <!-- Main glassmorphic background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/device_info_card_background"/>

        <!-- Top highlight reflection -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_gravity="top"
            android:layout_marginTop="1dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:background="#70FFFFFF"
            android:alpha="0.8"/>

        <!-- Three Column Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Item 1 -->
            <LinearLayout
                android:id="@+id/item1_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <!-- Icon Container -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/device_info_icon_bg"
                        android:alpha="0.5"/>

                    <ImageView
                        android:id="@+id/item1_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint"
                        android:contentDescription="@null"/>

                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:id="@+id/item1_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                    android:textColor="@color/device_info_summary"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <!-- Value -->
                <TextView
                    android:id="@+id/item1_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                    android:textColor="@color/device_info_title"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Divider 1 -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#20FFFFFF"/>

            <!-- Item 2 -->
            <LinearLayout
                android:id="@+id/item2_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <!-- Icon Container -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/device_info_icon_bg"
                        android:alpha="0.5"/>

                    <ImageView
                        android:id="@+id/item2_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint_secondary"
                        android:contentDescription="@null"/>

                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:id="@+id/item2_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                    android:textColor="@color/device_info_summary"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <!-- Value -->
                <TextView
                    android:id="@+id/item2_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                    android:textColor="@color/device_info_title"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Divider 2 -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:background="#20FFFFFF"/>

            <!-- Item 3 -->
            <LinearLayout
                android:id="@+id/item3_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground">

                <!-- Icon Container -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/device_info_icon_bg"
                        android:alpha="0.5"/>

                    <ImageView
                        android:id="@+id/item3_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint_tertiary"
                        android:contentDescription="@null"/>

                </FrameLayout>

                <!-- Label -->
                <TextView
                    android:id="@+id/item3_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                    android:textColor="@color/device_info_summary"
                    android:textSize="10sp"
                    android:gravity="center"/>

                <!-- Value -->
                <TextView
                    android:id="@+id/item3_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                    android:textColor="@color/device_info_title"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:gravity="center"/>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
