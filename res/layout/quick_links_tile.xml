<!-- Quick Links Tile - Compact Footer Links -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- Main Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <!-- Glassmorphic Background -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/device_info_card_background"/>

            <!-- Top Highlight -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="top"
                android:layout_marginTop="1dp"
                android:background="#40FFFFFF"/>

            <!-- Four Column Links -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:padding="8dp">

                <!-- Link 1: Manual -->
                <LinearLayout
                    android:id="@+id/link_manual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint"
                        android:alpha="0.7"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Manual"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                        android:textColor="@color/device_info_summary"
                        android:textSize="10sp"
                        android:gravity="center"/>

                </LinearLayout>

                <!-- Link 2: Feedback -->
                <LinearLayout
                    android:id="@+id/link_feedback"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint_secondary"
                        android:alpha="0.7"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Feedback"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                        android:textColor="@color/device_info_summary"
                        android:textSize="10sp"
                        android:gravity="center"/>

                </LinearLayout>

                <!-- Link 3: Legal -->
                <LinearLayout
                    android:id="@+id/link_legal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/glassmorphic_accent_tertiary"
                        android:alpha="0.7"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Legal"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                        android:textColor="@color/device_info_summary"
                        android:textSize="10sp"
                        android:gravity="center"/>

                </LinearLayout>

                <!-- Link 4: Regulatory -->
                <LinearLayout
                    android:id="@+id/link_regulatory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackgroundBorderless">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint"
                        android:alpha="0.7"
                        android:contentDescription="@null"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Regulatory"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                        android:textColor="@color/device_info_summary"
                        android:textSize="10sp"
                        android:gravity="center"/>

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
