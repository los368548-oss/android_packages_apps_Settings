<!-- Enhanced Device Info Card with 10-Level Glassmorphic Design -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <!-- Layer 1: Main glassmorphic background -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/device_info_card_background"/>

        <!-- Layer 2: Top highlight reflection -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:layout_marginTop="1dp"
            android:background="@color/glassmorphic_highlight"
            android:alpha="0.6"/>

        <!-- Layer 3: Subtle inner glow at top -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:background="@drawable/glassmorphic_inner_glow_top"/>

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Icon Container with Glow -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="16dp">

                    <!-- Icon background glow -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/device_info_icon_bg"/>

                    <!-- Icon -->
                    <ImageView
                        android:id="@+id/device_info_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_device_info_default"
                        android:tint="@color/device_info_icon_tint"
                        android:contentDescription="@null"/>

                </FrameLayout>

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title -->
                    <TextView
                        android:id="@+id/device_info_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SettingsLib.BodyLarge"
                        android:textColor="@color/device_info_title"
                        android:textStyle="medium"
                        android:letterSpacing="0.01"/>

                    <!-- Summary/Value -->
                    <TextView
                        android:id="@+id/device_info_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
                        android:textColor="@color/device_info_summary"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingMultiplier="1.1"/>

                </LinearLayout>

                <!-- Optional Arrow -->
                <ImageView
                    android:id="@+id/device_info_arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="@color/device_info_icon_tint"
                    android:alpha="0.5"
                    android:visibility="gone"
                    android:contentDescription="@null"/>

            </LinearLayout>

            <!-- Progress Bar Container (for storage, RAM, battery) -->
            <LinearLayout
                android:id="@+id/progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Progress Bar with glassmorphic track -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="10dp">

                    <!-- Track background -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/progress_track_background"/>

                    <!-- Progress -->
                    <ProgressBar
                        android:id="@+id/storage_progress"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:progressDrawable="@drawable/storage_progress_drawable"
                        android:max="100"
                        android:progress="50"
                        android:indeterminate="false"/>
                </FrameLayout>

                <!-- Progress Labels -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/used_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                        android:textColor="@color/device_info_summary"
                        android:letterSpacing="0.02"/>

                    <TextView
                        android:id="@+id/free_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SettingsLib.LabelSmall"
                        android:textColor="@color/device_info_summary"
                        android:letterSpacing="0.02"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
