<!-- HavocOOS: Google Account Tile with Avatar and Account Switcher -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:minHeight="@dimen/havoc_preference_min_height"
    android:gravity="center_vertical"
    android:background="@drawable/glassmorphic_selector_dynamic"
    android:layout_marginStart="@dimen/havoc_preference_margin_horizontal"
    android:layout_marginEnd="@dimen/havoc_preference_margin_horizontal"
    android:layout_marginTop="@dimen/havoc_preference_margin_vertical"
    android:layout_marginBottom="@dimen/havoc_preference_margin_vertical"
    android:clipToPadding="false"
    android:baselineAligned="false">

    <!-- Account Avatar -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/havoc_icon_container_min_width"
        android:minHeight="@dimen/havoc_icon_container_min_height"
        android:gravity="center"
        android:paddingStart="@dimen/havoc_padding_normal">

        <ImageView
            android:id="@+id/account_avatar"
            android:layout_width="@dimen/havoc_avatar_size"
            android:layout_height="@dimen/havoc_avatar_size"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="@drawable/circle"
            android:contentDescription="@string/google_account_avatar_content_description" />

    </FrameLayout>

    <!-- Account Info -->
    <LinearLayout
        android:id="@+id/text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="@dimen/havoc_padding_normal"
        android:paddingBottom="@dimen/havoc_padding_normal"
        android:paddingStart="@dimen/havoc_padding_normal"
        android:paddingEnd="@dimen/havoc_padding_relaxed">

        <TextView
            android:id="@+id/account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:singleLine="true"
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="@color/settingslib_text_color_primary"
            android:ellipsize="marquee" />

        <TextView
            android:id="@+id/account_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewStart"
            android:singleLine="true"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/settingslib_text_color_secondary"
            android:ellipsize="marquee" />

    </LinearLayout>

    <!-- Account Switcher Dropdown -->
    <FrameLayout
        android:id="@+id/switcher_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/havoc_icon_container_min_height"
        android:layout_gravity="center|end"
        android:paddingEnd="@dimen/havoc_padding_normal">

        <ImageView
            android:id="@+id/switcher_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_arrow_drop_down"
            android:tint="@color/settingslib_text_color_secondary"
            android:contentDescription="@string/google_account_switcher_description" />

    </FrameLayout>

</LinearLayout>
