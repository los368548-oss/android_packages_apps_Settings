<!-- Premium Device Info Card Background - Dark Mode with Purple Tint -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#28FFFFFF">
    
    <!-- Mask for ripple bounds -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    
    <item>
        <layer-list>
            
            <!-- Level 1: Deep shadow base with purple tint -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#10182030"
                        android:centerColor="#08101520"
                        android:endColor="#04080A10"
                        android:type="linear"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Level 2: Primary glass surface with purple tint -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#38182535"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Level 3: Diagonal light reflection -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="145"
                        android:startColor="#00FFFFFF"
                        android:centerColor="#15FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Level 4: Top highlight for glass reflection -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#28FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Level 5: Subtle accent glow at bottom -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="#12AB47BC"
                        android:centerColor="#08AB47BC"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="20dp"/>
                </shape>
            </item>
            
            <!-- Level 6: Inner glow border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="20dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#22FFFFFF"/>
                </shape>
            </item>
            
            <!-- Level 7: Outer accent glow border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="20dp"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="#184060FF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
</ripple>
