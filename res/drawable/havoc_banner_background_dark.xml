<!-- Premium Glassmorphic Banner Background - Dark Mode -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base layer with subtle purple tint -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <solid android:color="#35182535"/>
        </shape>
    </item>
    
    <!-- Primary glass surface -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp"/>
            <solid android:color="#D0121214"/>
        </shape>
    </item>
    
    <!-- Top highlight reflection -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:height="40dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="23dp" android:topRightRadius="23dp"/>
            <gradient
                android:angle="90"
                android:startColor="#25FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    
    <!-- Diagonal light reflection -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:height="60dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="23dp" android:topRightRadius="23dp"/>
            <gradient
                android:angle="45"
                android:startColor="#00FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF"/>
        </shape>
    </item>
    
    <!-- Inner glow from bottom with coral accent -->
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:height="30dp">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="23dp" android:bottomRightRadius="23dp"/>
            <gradient
                android:angle="270"
                android:startColor="#20FF8A65"
                android:endColor="#00FF8A65"/>
        </shape>
    </item>
    
    <!-- Outer border glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <stroke android:width="1dp" android:color="#25FFFFFF"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
    
    <!-- Inner subtle border -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="23dp"/>
            <stroke android:width="0.5dp" android:color="#30FFFFFF"/>
            <solid android:color="@android:color/transparent"/>
        </shape>
    </item>
    
</layer-list>