<!-- Device Info Card Background - Glassmorphic Style -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    
    <!-- Mask for ripple bounds -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <layer-list>
            <!-- Level 1: Base gradient for depth -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#12FFFFFF"
                        android:centerColor="#08FFFFFF"
                        android:endColor="#03FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            
            <!-- Level 2: Primary glass surface -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#30FFFFFF"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            
            <!-- Level 3: Top highlight -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#35FFFFFF"
                        android:centerColor="#10FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            
            <!-- Level 4: Border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="16dp"/>
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
</ripple>