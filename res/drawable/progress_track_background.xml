<!-- Premium Progress Track Background with Glassmorphic Style -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base track -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    
    <!-- Inner highlight -->
    <item android:top="0.5dp" android:bottom="0.5dp" android:left="0.5dp" android:right="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#15FFFFFF"/>
            <corners android:radius="3.5dp"/>
        </shape>
    </item>
    
</layer-list>
