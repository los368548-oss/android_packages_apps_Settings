<!-- Network & Internet Category - Blue Accent Glassmorphic -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glassmorphic_ripple_light">
    
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <item>
        <layer-list>
            <!-- Base gradient -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@color/glassmorphic_gradient_start"
                        android:centerColor="@color/glassmorphic_gradient_center"
                        android:endColor="@color/glassmorphic_gradient_end"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Primary glass surface -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glassmorphic_surface_light"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Top highlight -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="@color/glassmorphic_highlight_top"
                        android:centerColor="#18FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Network accent glow at bottom -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@color/category_accent_network_surface"
                        android:centerColor="@color/category_accent_network_surface"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke android:width="1dp" android:color="@color/glassmorphic_border_primary"/>
                </shape>
            </item>
            
            <!-- Accent border glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke android:width="0.5dp" android:color="@color/category_accent_network"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
</ripple>