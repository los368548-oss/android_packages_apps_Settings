<!-- 
  Material You Dynamic Glassmorphic Background v4.0
  
  This is the main entry point for dynamic glassmorphic backgrounds.
  It automatically switches between light and dark mode versions using
  Android's resource qualification system (drawable vs drawable-night).
  
  The colors automatically adapt to the user's wallpaper through Material You (Monet).
  When the user changes their wallpaper, the glassmorphic effect colors will update
  to match the new wallpaper's color palette.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Uses the dynamic selector which adapts to wallpaper colors -->
    <item android:drawable="@drawable/glassmorphic_selector_dynamic"/>
</selector>