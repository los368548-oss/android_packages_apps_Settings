<!-- Glassmorphic State Selector for Dark Mode with Ripple Effect -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    
    <!-- Mask for ripple bounds -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Base glassmorphic background for dark mode -->
    <item>
        <layer-list>
            <!-- Layer 1: Base gradient for depth simulation -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#20000000"
                        android:centerColor="#10000000"
                        android:endColor="#05000000"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 2: Primary semi-transparent dark glass surface -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#28000000"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 3: Top highlight for glass reflection effect -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="#18FFFFFF"
                        android:centerColor="#00FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 4: Inner glow border effect -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke
                        android:width="1.5dp"
                        android:color="#18FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
</ripple>
