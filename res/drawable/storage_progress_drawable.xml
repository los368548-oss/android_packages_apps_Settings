<!-- Premium Storage Progress Drawable with Gradient -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Progress background track -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    
    <!-- Secondary progress -->
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#30FF8A65"/>
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>
    
    <!-- Primary progress with gradient -->
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <!-- Gradient fill -->
                <item>
                    <shape android:shape="rectangle">
                        <gradient
                            android:angle="0"
                            android:startColor="#FF8A65"
                            android:centerColor="#FFAB91"
                            android:endColor="#26A69A"
                            android:type="linear"/>
                        <corners android:radius="4dp"/>
                    </shape>
                </item>
                <!-- Top highlight -->
                <item android:top="0dp" android:bottom="2dp">
                    <shape android:shape="rectangle">
                        <gradient
                            android:angle="90"
                            android:startColor="#40FFFFFF"
                            android:endColor="#00FFFFFF"
                            android:type="linear"/>
                        <corners android:radius="4dp"/>
                    </shape>
                </item>
            </layer-list>
        </clip>
    </item>
    
</layer-list>
