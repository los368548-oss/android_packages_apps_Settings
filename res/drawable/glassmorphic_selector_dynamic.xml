<!-- Premium Glassmorphic State Selector - Dynamic Material You Colors -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@androidprv:color/materialColorPrimary">
    
    <!-- Mask for ripple bounds -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Base glassmorphic background with enhanced layers -->
    <item>
        <layer-list>
            
            <!-- Layer 1: Deep shadow simulation with dynamic gradient -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="@androidprv:color/materialColorSurfaceContainer"
                        android:centerColor="@androidprv:color/materialColorSurfaceContainerHigh"
                        android:endColor="@androidprv:color/materialColorSurfaceContainer"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 2: Primary glass surface -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@androidprv:color/materialColorSurfaceContainerHigh"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 3: Diagonal light reflection -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="145"
                        android:startColor="#00FFFFFF"
                        android:centerColor="@androidprv:color/materialColorSurfaceBright"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 4: Top highlight for glass reflection -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="90"
                        android:startColor="@androidprv:color/materialColorSurfaceBright"
                        android:centerColor="#18FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 5: Subtle inner glow from bottom with primary accent -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:startColor="@androidprv:color/materialColorPrimaryContainer"
                        android:centerColor="@androidprv:color/materialColorSurfaceBright"
                        android:endColor="#00FFFFFF"
                        android:type="linear"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                </shape>
            </item>
            
            <!-- Layer 6: Refined border with glow effect -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke
                        android:width="1dp"
                        android:color="@androidprv:color/materialColorOutlineVariant"/>
                </shape>
            </item>
            
            <!-- Layer 7: Outer glow border -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00FFFFFF"/>
                    <corners android:radius="@dimen/havoc_corner_radius"/>
                    <stroke
                        android:width="0.5dp"
                        android:color="@androidprv:color/materialColorSurfaceBright"/>
                </shape>
            </item>
        </layer-list>
    </item>
    
</ripple>