<!-- Glassmorphic Background with Accent Tint for Highlighted Preferences -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Layer 1: Base gradient with accent tint -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#10FF8A65"
                android:centerColor="#08FF8A65"
                android:endColor="#03FF8A65"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 2: Primary semi-transparent glass surface with accent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#25FF8A65"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 3: Top highlight for glass reflection effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#30FF8A65"
                android:centerColor="#00FF8A65"
                android:endColor="#00FF8A65"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 4: Inner glow border with accent -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
            <stroke
                android:width="1.5dp"
                android:color="#35FF8A65"/>
        </shape>
    </item>
    
    <!-- Layer 5: Outer subtle border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
            <stroke
                android:width="0.5dp"
                android:color="#15FF8A65"/>
        </shape>
    </item>
    
</layer-list>
