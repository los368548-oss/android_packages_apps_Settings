<!-- Logo Glow Effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#15FF8A65"/>
            <size android:width="72dp" android:height="72dp"/>
        </shape>
    </item>
    
    <!-- Middle glow ring -->
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="oval">
            <solid android:color="#25FF8A65"/>
            <size android:width="60dp" android:height="60dp"/>
        </shape>
    </item>
    
    <!-- Inner glow ring -->
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#35FFFFFF"/>
            <stroke android:width="1dp" android:color="#40FF8A65"/>
            <size android:width="52dp" android:height="52dp"/>
        </shape>
    </item>
</layer-list>