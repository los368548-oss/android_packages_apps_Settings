<!-- Enhanced Glassmorphic Background with Multi-Layer Effects -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Layer 1: Base gradient for depth simulation -->
    <item>
        <shape android:shape="rectangle">
            <!-- Gradient from top-left to bottom-right for 3D glass effect -->
            <gradient
                android:angle="135"
                android:startColor="#15FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#03FFFFFF"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 2: Primary semi-transparent glass surface -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#35FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 3: Top highlight for glass reflection effect -->
    <item
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 4: Inner glow border effect -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
            <!-- Primary glass border -->
            <stroke
                android:width="1.5dp"
                android:color="#45FFFFFF"/>
        </shape>
    </item>
    
    <!-- Layer 5: Outer subtle shadow/border for depth -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
            <stroke
                android:width="0.5dp"
                android:color="#15FFFFFF"/>
        </shape>
    </item>
    
</layer-list>
