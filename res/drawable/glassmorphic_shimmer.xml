<!-- Premium Glassmorphic Background with Shimmer Effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Layer 1: Deep base gradient for premium depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#18FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#05FFFFFF"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 2: Primary glass surface with enhanced transparency -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#38FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 3: Shimmer highlight sweep effect -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#00FFFFFF"
                android:centerColor="#50FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 4: Top edge highlight for premium glass look -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#55FFFFFF"
                android:centerColor="#15FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 5: Bottom subtle reflection -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#10FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
        </shape>
    </item>
    
    <!-- Layer 6: Premium border with enhanced glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
            <stroke
                android:width="2dp"
                android:color="#50FFFFFF"/>
        </shape>
    </item>
    
    <!-- Layer 7: Outer glow effect -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00FFFFFF"/>
            <corners android:radius="@dimen/havoc_corner_radius"/>
            <stroke
                android:width="1dp"
                android:color="#20FFFFFF"/>
        </shape>
    </item>
    
</layer-list>
